databricks_host       = "https://dbc-xxxxxx.cloud.databricks.com"
databricks_account_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
uc_metastore_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
secret_scope_name     = "watts-up-coach"
