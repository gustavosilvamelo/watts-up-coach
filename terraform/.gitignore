# Local variable values — may contain secrets
terraform.tfvars

# OpenTofu/Terraform working directories
.terraform/
.terraform.lock.hcl

# State files — never commit state to version control
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
